# Fonts
font-family = Lilex Nerd Font
font-family-bold = Lilex Nerd Font
font-synthetic-style = bold
font-size = 10
bold-is-bright = true

# Cursor
cursor-style = block
cursor-color = d9e6f2
cursor-text = 29262f

# Mouse
mouse-hide-while-typing = true
copy-on-select = true

# Window
# window-padding-x = 2
# window-padding-y = 2
window-decoration = false
window-padding-balance = true

# Colors
foreground = c9cbff
background = 1c1c1c
background-opacity = 0.90
background-blur-radius = 20

# Selection
selection-background = f5e0dc
selection-foreground = 1e1e2e

# Clipboard
clipboard-read = allow
clipboard-write = allow

# Dracula ANSI Palette
palette = 0=282a36
palette = 1=ff5555
palette = 2=50fa7b
palette = 3=f1fa8c
palette = 4=bd93f9
palette = 5=ff79c6
palette = 6=8be9fd
palette = 7=f8f8f2
palette = 8=44475a
palette = 9=ff6e6e
palette = 10=69ff94
palette = 11=ffffa5
palette = 12=d6acff
palette = 13=ff92df
palette = 14=a4ffff
palette = 15=ffffff
