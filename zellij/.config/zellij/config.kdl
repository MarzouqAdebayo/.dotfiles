// Zellij configuration merging defaults with Tmux-inspired bindings
theme "catppuccin-macchiato"
default_shell "zsh"
default_layout "compact"
pane_frames true
simplified_ui true
copy_on_select true
copy_command "xclip -selection clipboard" // Adjust to pbcopy (macOS) or wl-copy (Wayland)
session_serialization true
pane_viewport_serialization true
auto_layout true
default_mode "locked" // Start in locked mode to free keys for Neovim

// Keybindings: Override defaults without clearing, use pane mode for Alt+h/j/k/l
keybinds {
    // Locked mode: Free keys for Neovim, minimal bindings
    locked {
        bind "Ctrl a" { SwitchToMode "tmux"; } // Enter tmux mode
    }

    // Normal mode: Keep defaults, override for Tmux compatibility
    normal {
        // Inherit defaults (e.g., Ctrl+g to locked, t to tab, r to resize)
        bind "Ctrl a" { SwitchToMode "tmux"; } // Tmux prefix
    }

    // Tmux mode: Tmux-like bindings with Ctrl-a prefix
    tmux clear-defaults=true {
        // Pane splits
        bind "|" { NewPane "right"; SwitchToMode "locked"; } // Ctrl+a |
        bind "-" { NewPane "down"; SwitchToMode "locked"; } // Ctrl+a -

        // Tab management
        bind "c" { NewTab; SwitchToMode "locked"; } // Ctrl+a c
        bind "z" { ToggleFocusFullscreen; SwitchToMode "locked"; } // Ctrl+a z
        bind "Tab" { GoToPreviousTab; } // Ctrl+a Tab
        bind "Shift Tab" { GoToNextTab; } // Ctrl+a Shift+Tab
        bind "Shift Left" { MoveTab "left"; SwitchToMode "locked"; } // Ctrl+a Shift+Left
        bind "Shift Right" { MoveTab "right"; SwitchToMode "locked"; } // Ctrl+a Shift+Right

        // Pane navigation
        bind "h" { MoveFocusOrTab "left"; }
        bind "j" { MoveFocus "down"; }
        bind "k" { MoveFocus "up"; }
        bind "l" { MoveFocusOrTab "right"; }

        // Pane resizing (5 units)
        bind "Alt h" { Resize "Increase left"; }
        bind "Alt j" { Resize "Increase down"; }
        bind "Alt k" { Resize "Increase up"; }
        bind "Alt l" { Resize "Increase right"; }

        // Rename tab
        bind "r" { SwitchToMode "RenameTab"; }

        // Escape should go back to locked mode in tmux mode
        bind "esc" { SwitchToMode "locked"; }

        // Sync panes
        bind "y" { TogglePaneFrames; SwitchToMode "locked"; } // Ctrl+a y

        // Detach
        bind "d" { Detach; }

        // Close focus
        bind "x" { CloseFocus; SwitchToMode "locked"; }

        // Copy mode
        bind "[" { SwitchToMode "scroll"; } // Ctrl+a [

        // Enter pane mode for navigation
        bind "p" { SwitchToMode "pane"; } // Ctrl+a p
    }

    // Pane mode: Alt+h/j/k/l for pane/tab navigation (overrides defaults)
    pane {
        // Override default h/j/k/l to avoid Neovim conflicts
        bind "h" { MoveFocus "left"; }
        bind "j" { MoveFocus "down"; }
        bind "k" { MoveFocus "up"; }
        bind "l" { MoveFocus "right"; }
        bind "Alt Left" { GoToPreviousTab; }
        bind "Alt Right" { GoToNextTab; }
        // Retain useful defaults (e.g., n for new pane, x to close)
        bind "esc" { SwitchToMode "locked"; } // Exit to locked
    }

    // Scroll mode: Vi-like copy mode
    scroll {
        bind "v" { EditScrollback; SwitchToMode "locked"; }
        bind "y" { Copy; SwitchToMode "locked"; }
        bind "esc" { SwitchToMode "locked"; }
    }
}

// UI: Tmux-like minimal look
ui {
    pane_frames {
        hide_session_name false
        rounded_corners false
    }
}
